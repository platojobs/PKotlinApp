<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/page_margin"
    android:paddingEnd="@dimen/page_margin">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/marketScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/marketContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/market_subtitle"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/catalogStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.App.Footnote"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/market_disclaimer"
                android:textAppearance="@style/TextAppearance.App.Footnote"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/market_compat_title"
                android:textAppearance="@style/TextAppearance.App.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/market_compat_hint"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/deviceTypeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:singleLine="false"
                app:singleSelection="true" />

            <LinearLayout
                android:id="@+id/compatibilityCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/compatibilityEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/market_compat_empty"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/market_guide_title"
                android:textAppearance="@style/TextAppearance.App.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/market_guide_hint"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/guideCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/market_services_title"
                android:textAppearance="@style/TextAppearance.App.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/market_services_hint"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/serviceEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/market_accessories_title"
                android:textAppearance="@style/TextAppearance.App.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/market_accessories_note"
                android:textAppearance="@style/TextAppearance.App.Footnote"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/showAccessoriesSwitch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_4"
                android:contentDescription="@string/market_accessories_toggle"
                android:text="@string/market_accessories_toggle"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/accessoriesUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/market_accessories_unavailable"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/accessoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.platojobs.pkotlinapp.ui.common.SkeletonView
        android:id="@+id/skeletonMarket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" />

    <FrameLayout
        android:id="@+id/emptyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
