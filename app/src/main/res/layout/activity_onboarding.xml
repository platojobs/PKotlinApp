<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/onboardingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <TextView
            style="@style/Widget.App.TextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skipButton"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:text="@string/onboarding_skip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stepGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin">

        <TextView
            android:id="@+id/stepIndicator"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/stepTitle"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:id="@+id/stepBody"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.App.Body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/page_margin"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultTitle"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:id="@+id/resultBody"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/statusScan"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:textAppearance="@style/TextAppearance.App.Callout" />

        <TextView
            android:id="@+id/statusConnect"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.App.Callout" />

        <TextView
            android:id="@+id/statusNotification"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.App.Callout" />

        <TextView
            android:id="@+id/resultBoundary"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/warning" />

        <TextView
            android:id="@+id/settingsHint"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:textAppearance="@style/TextAppearance.App.Footnote" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onboardingBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_continue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/onboarding_open_settings"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
