<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_8">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sceneNameLayout"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_h"
        android:hint="@string/scene_name_hint"
        app:boxBackgroundMode="outline">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sceneNameInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/scene_actions_title"
        android:textAppearance="@style/TextAppearance.App.Callout" />

    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/actionEmpty"
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_8"
        android:text="@string/scene_actions_empty"
        android:textAppearance="@style/TextAppearance.App.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addActionButton"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/scene_action_add" />

    <TextView
        android:id="@+id/sceneError"
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/danger"
        android:visibility="gone" />
</LinearLayout>
