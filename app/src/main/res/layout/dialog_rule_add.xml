<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rule_type_label"
        android:textAppearance="@style/TextAppearance.App.Callout" />

    <RadioGroup
        android:id="@+id/typeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/typeLowRssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/rule_low_rssi" />

        <RadioButton
            android:id="@+id/typeDisconnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rule_disconnected" />

        <RadioButton
            android:id="@+id/typeBondLost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rule_bond_lost" />

        <RadioButton
            android:id="@+id/typeMetric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rule_metric_threshold" />
    </RadioGroup>

    <TextView
        android:id="@+id/typeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/rule_desc_low_rssi"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/thresholdLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/rule_threshold_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/thresholdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberSigned"
            android:maxLength="4"
            android:text="@string/rule_threshold_default" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/metricFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rule_metric_label"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <Spinner
            android:id="@+id/metricSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rule_metric_comparator_label"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <Spinner
            android:id="@+id/comparatorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/metricThresholdLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rule_metric_threshold_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/metricThresholdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/consecutiveLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rule_metric_consecutive_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/consecutiveInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:text="@string/rule_consecutive_default" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

</LinearLayout>
