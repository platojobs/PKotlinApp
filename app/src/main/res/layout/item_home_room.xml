<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_4">

    <!-- 展开/折叠是独立动作，与「打开房间详情」分开，避免一个标题承担两种语义。 -->
    <TextView
        android:id="@+id/roomArrow"
        style="@style/Widget.App.TextView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/roomTitle"
        style="@style/Widget.App.TextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.Callout"
        android:textStyle="bold"
        tools:text="客厅" />

    <TextView
        android:id="@+id/roomMeta"
        style="@style/Widget.App.TextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary"
        tools:text="3 台设备" />
</LinearLayout>
