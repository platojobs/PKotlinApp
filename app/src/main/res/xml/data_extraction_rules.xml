<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false 时仍显式声明不参与云备份与设备迁移，避免系统默认策略变化。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
