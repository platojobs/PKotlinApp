<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 字号阶梯：10 级，全部走 sp；数值样式启用等宽数字。 -->

    <style name="TextAppearance.App.Display" parent="@android:style/TextAppearance">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <style name="TextAppearance.App.Title" parent="@android:style/TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">8dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:letterSpacing">-0.007</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="@android:style/TextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextAppearance.App.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">7dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextAppearance.App.Callout" parent="@android:style/TextAppearance">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="@android:style/TextAppearance">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextAppearance.App.Footnote" parent="@android:style/TextAppearance">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <!-- 底部导航标签：Material 规范 12sp；选中态同时用字重与颜色区分，避免只靠颜色变淡。 -->
    <style name="TextAppearance.App.NavLabelActive" parent="@android:style/TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextAppearance.App.NavLabelInactive" parent="@android:style/TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextAppearance.App.NumericXL" parent="@android:style/TextAppearance">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="TextAppearance.App.NumericL" parent="@android:style/TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.App.NumericM" parent="@android:style/TextAppearance">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- 按钮文字：Body 17 Medium -->
    <style name="TextAppearance.App.Button" parent="@style/TextAppearance.App.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="Widget.App.TextView" parent="android:Widget.TextView">
        <item name="android:includeFontPadding">false</item>
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>

    <!-- 按钮：只变色不缩放、无阴影 -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="cornerRadius">@dimen/radius_12</item>
        <item name="rippleColor">@color/overlay_pressed</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">@dimen/stroke_1</item>
        <item name="cornerRadius">@dimen/radius_12</item>
        <item name="rippleColor">@color/overlay_pressed</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="rippleColor">@color/overlay_pressed</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="backgroundTint">@color/btn_danger_bg</item>
        <item name="android:textColor">@color/btn_danger_text</item>
        <item name="cornerRadius">@dimen/radius_12</item>
        <item name="rippleColor">@color/overlay_pressed</item>
    </style>

    <!-- 列表卡片：1dp 描边、零阴影、12 圆角 -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_1</item>
        <item name="cardCornerRadius">@dimen/radius_12</item>
        <item name="cardElevation">@dimen/elevation_0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/overlay_pressed</item>
    </style>

    <!-- Chip：未选 surface + 1dp border，选中区间带底 + 1dp 主色 -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_1</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Caption</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipMinHeight">@dimen/chip_h</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- 输入框：52 高、10 圆角、1dp 可交互描边，聚焦 2dp 主色 -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_1</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_2</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_10</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_10</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_10</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_10</item>
        <item name="hintTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
    </style>

    <!-- 状态与轻提示容器 -->
    <style name="Widget.App.ErrorBlock" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_16</item>
        <item name="android:minHeight">120dp</item>
    </style>

    <style name="Widget.App.Toolbar.Title" parent="@style/TextAppearance.App.Headline">
        <item name="android:gravity">center</item>
    </style>
</resources>
