<?xml version="1.0" encoding="utf-8"?>
<!--
  设备详情页的后台采集开关与说明。单独成文件是为了让 activity_device_detail.xml
  保持较低的视图层级数量，避免 TooManyViews 性能告警。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/collectionSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/detail_collection_switch"
        android:visibility="gone" />

    <TextView
        android:id="@+id/collectionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detail_collection_desc"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
