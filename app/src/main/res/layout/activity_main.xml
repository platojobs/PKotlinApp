<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 自绘大标题：展开 96dp，滚动 12dp 后收为 56dp（200ms 插值） -->
    <FrameLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas">

        <LinearLayout
            android:id="@+id/headerLargeArea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_h_expanded"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin">

            <TextView
                android:id="@+id/headerTitleLarge"
                style="@style/Widget.App.TextView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:paddingBottom="@dimen/space_12"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.App.Display"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerTitleCollapsed"
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_bar_h"
            android:alpha="0"
            android:gravity="center"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:id="@+id/headerDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_1"
            android:layout_gravity="bottom"
            android:alpha="0"
            android:background="@color/divider" />
    </FrameLayout>

    <TextView
        android:id="@+id/syncBanner"
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warning_bg"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingVertical="@dimen/space_8"
        android:text="@string/sync_banner_local_only"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/warning"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.platojobs.pkotlinapp.ui.common.SkeletonView
            android:id="@+id/shellSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginEnd="@dimen/page_margin" />
    </FrameLayout>

    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_1"
        android:background="@color/divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bottom_nav_h"
        android:background="@color/canvas"
        app:elevation="@dimen/elevation_0"
        app:itemActiveIndicatorStyle="@null"
        app:itemGravity="center"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemPaddingBottom="0dp"
        app:itemPaddingTop="0dp"
        app:itemRippleColor="@color/overlay_pressed"
        app:itemTextAppearanceActive="@style/TextAppearance.App.NavLabelActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.NavLabelInactive"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
