<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_8">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sceneNameLayout"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_h"
        android:hint="@string/scene_name_hint"
        app:boxBackgroundMode="outline">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sceneNameInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/scene_trigger_title"
        android:textAppearance="@style/TextAppearance.App.Callout" />

    <RadioGroup
        android:id="@+id/triggerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/triggerManual"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/scene_trigger_manual" />

        <RadioButton
            android:id="@+id/triggerDisconnected"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/scene_trigger_disconnected" />

        <RadioButton
            android:id="@+id/triggerLowRssi"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/scene_trigger_low_rssi" />

        <RadioButton
            android:id="@+id/triggerMetric"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/scene_trigger_metric" />

        <RadioButton
            android:id="@+id/triggerSchedule"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:text="@string/scene_trigger_schedule" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rssiThresholdLayout"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_h"
        android:hint="@string/scene_trigger_rssi_hint"
        android:visibility="gone"
        app:boxBackgroundMode="outline">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rssiThresholdInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="numberSigned"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/metricTriggerFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Spinner
            android:id="@+id/triggerMetricSpinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/triggerComparatorSpinner"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/triggerMetricThresholdLayout"
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_h"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:hint="@string/rule_threshold_hint"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/triggerMetricThresholdInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Body" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/triggerConsecutiveLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_h"
            android:hint="@string/scene_trigger_consecutive_hint"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/triggerConsecutiveInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="number"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scheduleTriggerFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Widget.App.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scene_trigger_interval"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <Spinner
            android:id="@+id/triggerIntervalSpinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min" />
    </LinearLayout>

    <TextView
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/scene_actions_title"
        android:textAppearance="@style/TextAppearance.App.Callout" />

    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/actionEmpty"
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_8"
        android:text="@string/scene_actions_empty"
        android:textAppearance="@style/TextAppearance.App.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addActionButton"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/scene_action_add" />

    <TextView
        android:id="@+id/sceneError"
        style="@style/Widget.App.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/danger"
        android:visibility="gone" />
</LinearLayout>
